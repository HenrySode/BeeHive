# OS and editor cruft
.DS_Store
Thumbs.db
*.swp
.vscode/*
!.vscode/extensions.json
.idea

# Environment files, never commit secrets
.env
.env.*
!.env.example

# Backend, once scaffolded (node_modules etc. mirror frontend/.gitignore)
backend/node_modules/
backend/dist/
backend/build/
backend/.env*
!backend/.env.example

# frontend/ has its own .gitignore covering node_modules, .next, etc.
